# AutoFuzz on the oldest supported system: Ubuntu 20.04, Python 3.8, clang 10.
# This is the same setup as the developer VM (see docs/INSTALL.md).
#
#   docker build -f Dockerfile.ubuntu20 -t autofuzz:ubuntu20 .
#   docker run --rm autofuzz:ubuntu20                          # = make test
#
# The main Dockerfile uses Ubuntu 24.04 + clang 18.
FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# clang-10              compiler (it pulls in libclang-common-10-dev, which
#                       has the libFuzzer and sanitizer runtimes)
# llvm-10               llvm-symbolizer, so sanitizer reports show file:line
# build-essential make  C library headers, make
# libcmocka-dev         unit test framework
# python3-venv          Python 3.8 for AutoFuzz
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        clang-10 libclang-common-10-dev llvm-10 \
        build-essential make libcmocka-dev \
        python3 python3-venv ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/bin/clang-10 /usr/local/bin/clang

ENV ASAN_SYMBOLIZER_PATH=/usr/bin/llvm-symbolizer-10

# The pip that comes with Ubuntu 20.04 (20.0) is too old for some wheels,
# so it is upgraded first.
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app
COPY . /app

RUN python3 --version && make build

CMD ["make", "test"]
