# =============================================================================
# STM32CubeIDE firmware build
# =============================================================================
Debug/
Release/

# Compiler output
*.elf
*.bin
*.hex
*.map
*.list
*.o
*.d
*.su
*.cyclo

# Local STM32CubeIDE workspace files
.settings/
.cproject
.project

# =============================================================================
# AutoFuzz (Tests/unit_tests) - everything below is recreated by `make build`
# =============================================================================
Tests/unit_tests/build/
Tests/unit_tests/_autofuzz.stamp

# Generated harness sources and their binaries
Tests/unit_tests/deterministic_edge_*
Tests/unit_tests/random_fuzz_*
Tests/unit_tests/edge_*
Tests/unit_tests/random_*_fz*
Tests/unit_tests/test_manual

# Output of `make fuzz`
Tests/unit_tests/crashes/
Tests/unit_tests/lf_corpus/
Tests/unit_tests/corpus/
Tests/unit_tests/logs/

# =============================================================================
# Hand-written fuzzers (Tests/fuzz_manual)
# =============================================================================
Tests/fuzz_manual/bin/
Tests/fuzz_manual/out/
Tests/fuzz_manual/work_corpus/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# =============================================================================
# Editors / misc
# =============================================================================
.vscode/
*.log
*.tmp
*.bak
*.swp
*.orig

# libFuzzer writes crash-*/leak-*/timeout-* files into the current folder
crash-*
leak-*
timeout-*
oom-*
!Tests/fuzz_manual/crashes/crash-*
