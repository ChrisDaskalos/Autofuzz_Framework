# =============================================================================
# STM32CubeIDE firmware build
# =============================================================================
Debug/
Release/

# Compiler output
*.elf
*.bin
*.hex
*.map
*.list
*.o
*.d
*.su
*.cyclo

# Local STM32CubeIDE workspace files
.settings/
.cproject
.project

# =============================================================================
# AutoFuzz (Tests/legacy_thesis) - everything below is recreated by `make build`
# =============================================================================
Tests/legacy_thesis/build/
Tests/legacy_thesis/_autofuzz.stamp

# Generated harness sources and their binaries
Tests/legacy_thesis/deterministic_edge_*
Tests/legacy_thesis/random_fuzz_*
Tests/legacy_thesis/edge_*
Tests/legacy_thesis/random_*_fz*
Tests/legacy_thesis/test_manual

# Output of `make fuzz`
Tests/legacy_thesis/crashes/
Tests/legacy_thesis/lf_corpus/
Tests/legacy_thesis/corpus/
Tests/legacy_thesis/logs/

# Output of `autofuzz` (any project)
autofuzz-out/

# Output of the top-level `make test`
Tests/results/

# =============================================================================
# Hand-written fuzzers (Tests/fuzz_manual)
# =============================================================================
Tests/fuzz_manual/bin/
Tests/fuzz_manual/out/
Tests/fuzz_manual/work_corpus/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
/build/          # created by `pip install .`
.pytest_cache/

# =============================================================================
# Editors / misc
# =============================================================================
.vscode/
*.log
*.tmp
*.bak
*.swp
*.orig

# libFuzzer writes crash-*/leak-*/timeout-* files into the current folder
crash-*
leak-*
timeout-*
oom-*
