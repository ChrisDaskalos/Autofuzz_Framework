# =============================================================================
# STM32CubeIDE / Embedded Development
# =============================================================================

# Build directories
Debug/
Release/
build/

# Build artifacts
*.elf
*.bin
*.hex
*.map
*.list
*.o
*.d
*.su
*.cyclo

# STM32CubeIDE project files
.settings/
.cproject
.project
*.launch

# STM32CubeMX generated (can be regenerated from .ioc)
# UNCOMMENT if you want to regenerate HAL from .ioc file:
 Drivers/STM32F1xx_HAL_Driver/
 Drivers/CMSIS/
 Core/Src/stm32f1xx_it.c
 Core/Src/stm32f1xx_hal_msp.c
 Core/Src/system_stm32f1xx.c
 Core/Inc/stm32f1xx_it.h
 Core/Inc/stm32f1xx_hal_conf.h

# Keep these STM32 files (needed for build):
# !ServoProject.ioc        # CubeMX project file (regenerates Drivers/)
# !STM32F103RBTX_FLASH.ld  # Linker script
# !Core/Startup/*.s        # Startup assembly

# =============================================================================
# AutoFuzz Testing Framework
# =============================================================================

# Compiled test executables (regenerated by make)
Tests/unit_tests/deterministic_edge_*
Tests/unit_tests/random_fuzz_*
Tests/unit_tests/test_manual
Tests/unit_tests/*.elf
!Tests/unit_tests/*.c
!Tests/unit_tests/*.h

# Test logs (regenerated each run)
Tests/unit_tests/logs/
*.log

# Evolved fuzzing corpus (large, binary, regenerated)
Tests/unit_tests/lf_corpus/
Tests/unit_tests/corpus/

# Test build artifacts
Tests/unit_tests/build/
Tests/unit_tests/_autofuzz.stamp

# IMPORTANT: Keep these test files (needed for bug reproduction)
!Tests/unit_tests/crashes/
!Tests/unit_tests/autofuzz/

# =============================================================================
# Python (AutoFuzz generator)
# =============================================================================

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
*.pyc

# =============================================================================
# IDE / Editor
# =============================================================================

# VS Code
.vscode/

# =============================================================================
# Documentation (optional - uncomment if you generate docs)
# =============================================================================

# LaTeX build artifacts
# *.aux
# *.log
# *.out
# *.toc
# *.pdf

# Keep the main PDF
!ServoProject.pdf
!README.pdf



# =============================================================================
# Miscellaneous
# =============================================================================

# Temporary files
*.tmp
*.bak
*.swp
*.orig

